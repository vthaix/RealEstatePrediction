   "source": [
    "để so sánh trực quan hơn thì nên so sánh theo giá tiền trên m2. nên tạo thêm 1 cột giá 1m2 sẽ là bao nhiêu. với cột price_per_m2 = price/area"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "7f76ac32",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"price_per_m2\"] = df[\"price\"] / df[\"area\"]"
   ]
