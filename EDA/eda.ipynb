   "source": [
    "# 14. Hướng ban công ảnh hưởng thế nào đến giá?\n",
    "\n",
    "phần nhiều dữ liệu là hướng bancol nó giống như hướng nhà nên nó y chang hướng nhà"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "481de312",
   "metadata": {
    "vscode": {
     "languageId": "sql"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "price_ty: ngưỡng [-10.58, 28.57], số outlier = 914 (9.9%)\n",
      "area: ngưỡng [-42.50, 217.50], số outlier = 1005 (10.1%)\n",
      "price_per_m2: ngưỡng [-150393860.20, 388001833.36], số outlier = 352 (3.8%)\n"
     ]
    }
   ],
   "source": [
    "def iqr_outlier_bounds(series):\n",
    "    q1, q3 = series.quantile([0.25, 0.75])\n",
    "    iqr = q3 - q1\n",
    "    return q1 - 1.5 * iqr, q3 + 1.5 * iqr\n",
    "\n",
    "for col in [\"price_ty\", \"area\", \"price_per_m2\"]:\n",
    "    s = df[col].dropna()\n",
    "    low, high = iqr_outlier_bounds(s)\n",
    "    n_outliers = ((s < low) | (s > high)).sum()\n",
    "    print(f\"{col}: ngưỡng [{low:.2f}, {high:.2f}], số outlier = {n_outliers} ({n_outliers/len(s)*100:.1f}%)\")\n"
   ]
  },
