    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df = pd.read_csv(\"../dataset/vietnam_real_estate_fnl.csv\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b1a75436",
   "metadata": {},
   "source": [
    "# 11. Vị trí nhà (mặt tiền/hẻm...) ảnh hưởng thế nào đến giá?\n",
    "\n",
    "với bộ dữ liệu này chưa có cột location_type(mặt tiền), nên giờ phải tạo thêm 1 cột mới được trích xuất từ cột name và description"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "3efe8e7e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# gộp 2 cột name và description lại để tìm thông tin mặt tiền, hẹp từ 2 cột này\n",
    "df[\"text_content\"] = (\n",
    "    df[\"name\"].fillna(\"\") + \" \" + \n",
    "    df[\"description\"].fillna(\"\")\n",
    ").str.lower()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cadc7369",
   "metadata": {},
   "outputs": [
